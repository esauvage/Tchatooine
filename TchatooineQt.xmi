      <packagedElement xmi:type="uml:Class" xmi:id="uDqxmIOpEYXpp" name="Serveur" comment="Le serveur écoute sur un port. Quand un client s'y connecte, il crée une connexion, qu'il passe à Tchat.">
        <ownedAttribute xmi:type="uml:Property" xmi:id="uwFdu5Ehk8tbf" name="_portPrive" comment="Le port sur le réseau privé." visibility="private" type="uXh7nL7ssWhfs"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="uPVhcjUiRB0I2" name="_portPublic" comment="Le port sur le réseau public." visibility="private" type="uXh7nL7ssWhfs"/>
