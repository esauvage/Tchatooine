        <ownedOperation xmi:type="uml:Operation" xmi:id="uxgxIfoQVmOOq" name="connectePair" comment="Connecte le client à un pair">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="unlFoumXE5QUR" name="pair" comment="Url du pair" visibility="private" type="ufYQqDyctYobO" value=""/>
        </ownedOperation>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="u9QstOAoFdk6G" name="Tchat" comment="Le Tchat, en pair-à-pair, comprend 3 parties :&#10;1. Le serveur qui propose le service.&#10;2. Le client, qui se connecte à un serveur pair (ça peut être le même serveur de chat).&#10;3. La liste des clients connectés au serveur.&#10;&#10;On voit ici un problème de conception : le tchat est essentiellement un client, et par ailleurs, on propose un service de serveur. La liste des clients connectés devrait donc être dans le serveur.">
        <ownedAttribute xmi:type="uml:Property" xmi:id="uX0OVV2c8MQFa" name="_serveur" visibility="private" type="uDqxmIOpEYXpp"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="uTuZu870nqMUf" name="_client" visibility="private" type="u98QKwkxYyLyi"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="uk9Jnw8XDzqdV" name="_pConn" comment="La liste des sockets de connexion" visibility="private" type="u5JpfTljjWPs7"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="uoGMspeYLaXzk" name="init" comment="On initialise le chat avec les informations du serveur du pair.">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="ubJK0PQXAyeWZ" name="ip" visibility="private" type="ufcbZ8XOyi8L1" value=""/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="ujTzVNRSC5TY8" name="port" visibility="private" type="uXh7nL7ssWhfs" value=""/>
        </ownedOperation>
      </packagedElement>
