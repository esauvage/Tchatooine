        <ownedOperation xmi:type="uml:Operation" xmi:id="uubN1ADb20rfr" name="demarre" comment="Démarre l'écoute du serveur sur le port interne."/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="uQqMLyUmTzxKU" name="getUpNP" comment="Cherche un équipement IGP, puis demande un port en protocole Upnp"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="uYBEKNKhTdN7z" name="incomingConnection" comment="C'est la fonction appelée lors d'une connexion entrante.">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="uF6hQtgNFHzCO" name="socketDescriptor" comment="Le descripteur de socket qui permet de créer le QTcpSocket gestionnaire de cette socket." visibility="private" type="ulpYj4pFDDtAD" value=""/>
        </ownedOperation>
      </packagedElement>
